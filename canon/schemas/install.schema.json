{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "install",
  "description": "aquas.install.json: marks the Aquas root and records how it was installed. Not versioned (.gitignore).",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "os", "os_version", "arch", "shell", "root", "product", "canon_version", "installed_at", "generated_by"],
  "properties": {
    "role": { "enum": ["central", "instance"] },
    "os": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "os_version": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "arch": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "shell": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "root": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "product": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "canon_version": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "installed_at": { "type": "string", "format": "date-time" },
    "generated_by": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" }
  }
}
