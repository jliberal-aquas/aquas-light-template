{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "defects",
  "description": "Register of agent failures, each with its preventive control.",
  "type": "object",
  "additionalProperties": false,
  "required": ["defects"],
  "properties": {
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "class", "failure", "seen_by", "control", "test", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^D[0-9]{4}$" },
          "date": { "type": "string", "format": "date" },
          "class": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "failure": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "seen_by": { "enum": ["human", "agent"] },
          "control": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "test": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "state": { "enum": ["proposed", "implemented", "tested"] }
        }
      }
    }
  }
}
