{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report",
  "description": "Return of a subagent to the orchestrator. No length limits; a large deliverable goes to disk with its path and sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["conclusion", "findings", "evidence", "pending", "certainty", "checklist"],
  "properties": {
    "conclusion": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "where", "why", "certainty", "severity"],
        "properties": {
          "what": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "where": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "why": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "certainty": { "$ref": "#/$defs/certainty" },
          "severity": { "enum": ["blocker", "major", "minor"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "quote"],
        "properties": {
          "file": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "line": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" }
        }
      }
    },
    "output": { "type": "object", "description": "Optional deliverable of the task; free shape." },
    "pending": { "type": "array", "items": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" } },
    "certainty": { "$ref": "#/$defs/certainty" },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
          "status": { "enum": ["done", "not_applicable"] },
          "evidence": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" }
        }
      }
    }
  },
  "$defs": {
    "certainty": { "enum": ["verified", "inferred", "hypothesis", "unknown"] }
  }
}
