{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "handoff",
  "description": "Delegation handed from the orchestrator to subagents. No length limits (ADR 0002). That agent exists in roles.json is checked by the F002 hook, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "tasks"],
  "properties": {
    "context": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "task", "solutionSpace"],
      "properties": {
        "agent": { "type": "string", "pattern": "^[a-z]+$", "not": { "const": "orchestrator" } },
        "task": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
        "solutionSpace": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
        "name": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
        "outputSchema": { "type": "object" },
        "schemaMode": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
        "tools": { "type": "array", "items": { "type": "string", "pattern": "[^\\s\u000b\ufeff\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" } },
        "isolated": { "type": "boolean" }
      }
    }
  }
}
